[Unit]
Description=Wispy Runtime Bridge (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/franco/.openclaw/workspace/gringoestate
Environment=WISPY_RUNTIME_HOST=127.0.0.1
Environment=WISPY_RUNTIME_PORT=8787
EnvironmentFile=/home/franco/.openclaw/workspace/gringoestate/.env.runtime-bridge
ExecStart=/home/franco/.nvm/versions/node/v22.22.2/bin/node /home/franco/.openclaw/workspace/gringoestate/runtime/wispy-runtime-bridge.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
