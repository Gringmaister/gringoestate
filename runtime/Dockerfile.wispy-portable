FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY . .

ENV WISPY_PANEL_DATA_DIR=/data/panel \
    WISPY_RUNTIME_HOST=0.0.0.0 \
    WISPY_RUNTIME_PUBLIC=1 \
    WISPY_RUNTIME_PORT=8787 \
    WISPY_API_HOST=0.0.0.0 \
    WISPY_API_PORT=8788

EXPOSE 8787 8788

CMD ["node", "runtime/wispy-portable-api.js"]
