FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg ca-certificates git bash \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/gringoestate

COPY gringoestate/package.json /tmp/gringoestate-package.json
RUN npm install -g openclaw@2026.4.23 \
  && mkdir -p /workspace/gringoestate \
  && cp /tmp/gringoestate-package.json /workspace/gringoestate/package.json \
  && cd /workspace/gringoestate \
  && npm install --omit=dev \
  && python3 -m pip install --no-cache-dir faster-whisper psutil

COPY . /workspace

RUN chmod +x /workspace/gringoestate/runtime/wispy-portable-supervisor.sh

ENV HOME=/data/home \
    WISPY_PANEL_DATA_DIR=/data/panel \
    OPENCLAW_GATEWAY_PORT=18789 \
    OPENCLAW_GATEWAY_BIND=lan \
    WISPY_API_HOST=0.0.0.0 \
    WISPY_API_PORT=8788 \
    WISPY_RUNTIME_HOST=0.0.0.0 \
    WISPY_RUNTIME_PORT=8787 \
    WISPY_RUNTIME_PUBLIC=1

EXPOSE 18789 8787 8788

CMD ["/workspace/gringoestate/runtime/wispy-portable-supervisor.sh"]
